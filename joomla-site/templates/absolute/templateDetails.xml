<?xml version="1.0" encoding="utf-8"?>
<extension version="5.0" type="template" client="site" method="upgrade">
    <name>absolute</name>
    <version>1.0.0</version>
    <creationDate>2026-01-12</creationDate>
    <author>Absolute Adventure Safaris</author>
    <copyright>Copyright (C) 2026 Absolute Adventure Safaris</copyright>
    <license>Proprietary</license>
    <description>TPL_ABSOLUTE_XML_DESCRIPTION</description>

    <files>
        <folder>html</folder>
        <folder>css</folder>
        <folder>js</folder>
        <folder>images</folder>
        <folder>language</folder>
        <folder>scss</folder>
        <filename>index.php</filename>
        <filename>templateDetails.xml</filename>
        <filename>templatePreview.png</filename>
        <filename>templateThumbnail.png</filename>
        <filename>favicon.ico</filename>
        <filename>component.php</filename>
        <filename>error.php</filename>
        <filename>offline.php</filename>
    </files>

    <positions>
        <position>header</position>
        <position>topbar</position>
        <position>menu</position>
        <position>search</position>
        <position>breadcrumb</position>
        <position>main-top</position>
        <position>content-top</position>
        <position>content</position>
        <position>content-bottom</position>
        <position>sidebar-left</position>
        <position>sidebar-right</position>
        <position>main-bottom</position>
        <position>footer-top</position>
        <position>footer</position>
        <position>footer-bottom</position>
        <position>debug</position>
        <position>cookie-consent</position>
    </positions>

    <config>
        <fields name="params">
            <fieldset name="basic" label="TPL_ABSOLUTE_BASIC_SETTINGS">
                <field name="siteName" type="text" label="TPL_ABSOLUTE_SITE_NAME" default="Absolute Adventure Safaris" />
                <field name="siteTagline" type="text" label="TPL_ABSOLUTE_SITE_TAGLINE" default="Leading provider of quality leisure and vacation experiences" />
                <field name="logoFile" type="media" label="TPL_ABSOLUTE_LOGO" directory="images" />
                <field name="faviconFile" type="media" label="TPL_ABSOLUTE_FAVICON" directory="images" />
            </fieldset>

            <fieldset name="colors" label="TPL_ABSOLUTE_COLOR_SETTINGS">
                <field name="primaryColor" type="color" label="TPL_ABSOLUTE_PRIMARY_COLOR" default="#1a5f3a" />
                <field name="secondaryColor" type="color" label="TPL_ABSOLUTE_SECONDARY_COLOR" default="#d4a843" />
                <field name="accentColor" type="color" label="TPL_ABSOLUTE_ACCENT_COLOR" default="#e86c00" />
                <field name="darkColor" type="color" label="TPL_ABSOLUTE_DARK_COLOR" default="#0d2d1a" />
                <field name="lightColor" type="color" label="TPL_ABSOLUTE_LIGHT_COLOR" default="#f8f9fa" />
            </fieldset>

            <fieldset name="api" label="TPL_ABSOLUTE_API_SETTINGS">
                <field name="apiBaseUrl" type="url" label="TPL_ABSOLUTE_API_URL" default="https://api.absoluteadventuresafaris.com/v1" />
                <field name="bookingAppUrl" type="url" label="TPL_ABSOLUTE_BOOKING_URL" default="https://book.absoluteadventuresafaris.com" />
                <field name="itineraryAppUrl" type="url" label="TPL_ABSOLUTE_ITINERARY_URL" default="https://plan.absoluteadventuresafaris.com" />
                <field name="agentAppUrl" type="url" label="TPL_ABSOLUTE_AGENT_URL" default="https://agents.absoluteadventuresafaris.com" />
            </fieldset>

            <fieldset name="features" label="TPL_ABSOLUTE_FEATURES">
                <field name="enableSearch" type="radio" label="TPL_ABSOLUTE_ENABLE_SEARCH" default="1">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="enableMultiLang" type="radio" label="TPL_ABSOLUTE_ENABLE_MULTILANG" default="1">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="enableCookieConsent" type="radio" label="TPL_ABSOLUTE_ENABLE_COOKIE_CONSENT" default="1">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="enableAnalytics" type="radio" label="TPL_ABSOLUTE_ENABLE_ANALYTICS" default="1">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>

            <fieldset name="social" label="TPL_ABSOLUTE_SOCIAL">
                <field name="facebookUrl" type="url" label="TPL_ABSOLUTE_FACEBOOK" />
                <field name="twitterUrl" type="url" label="TPL_ABSOLUTE_TWITTER" />
                <field name="instagramUrl" type="url" label="TPL_ABSOLUTE_INSTAGRAM" />
                <field name="youtubeUrl" type="url" label="TPL_ABSOLUTE_YOUTUBE" />
                <field name="linkedinUrl" type="url" label="TPL_ABSOLUTE_LINKEDIN" />
                <field name="tripadvisorUrl" type="url" label="TPL_ABSOLUTE_TRIPADVISOR" />
            </fieldset>

            <fieldset name="contact" label="TPL_ABSOLUTE_CONTACT">
                <field name="phoneKenya" type="text" label="TPL_ABSOLUTE_PHONE_KENYA" default="" />
                <field name="phoneWhatsapp" type="text" label="TPL_ABSOLUTE_PHONE_WHATSAPP" default="" />
                <field name="emailGeneral" type="email" label="TPL_ABSOLUTE_EMAIL_GENERAL" default="" />
                <field name="emailBookings" type="email" label="TPL_ABSOLUTE_EMAIL_BOOKINGS" default="" />
                <field name="address" type="textarea" label="TPL_ABSOLUTE_ADDRESS" default="" />
            </fieldset>
        </fields>
    </config>
</extension>