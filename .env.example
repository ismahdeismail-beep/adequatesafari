# Adequate Safaris - Environment Configuration
# Copy to .env (or set in your host's dashboard) and fill in real values.
# Never commit a real .env — only this example.

# ──────────────────────────────────────────────
# RUNTIME
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated allowed browser origins for the API (CORS).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:8080

# ──────────────────────────────────────────────
# DATABASE (Prisma reads this exact name)
# ──────────────────────────────────────────────
DATABASE_URL=mysql://joomla:joomla@localhost:3306/joomla
MYSQL_ROOT_PASSWORD=generate_strong_password_here
JOOMLA_DB_PASSWORD=generate_strong_password_here

# ──────────────────────────────────────────────
# JOOMLA
# ──────────────────────────────────────────────
JOOMLA_ADMIN_PASSWORD=generate_strong_password_here
JOOMLA_API_URL=http://localhost:8080
JOOMLA_API_TOKEN=generate_long_random_token_here

# ──────────────────────────────────────────────
# JWT / AUTH
# ──────────────────────────────────────────────
JWT_SECRET=generate_very_long_random_string_here_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ──────────────────────────────────────────────
# STRIPE (International Payments)
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2024-06-20

# ──────────────────────────────────────────────
# M-PESA / DARAJA (Kenya Payments)
# ──────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey
MPESA_SHORTCODE=your_business_shortcode
MPESA_ENVIRONMENT=sandbox  # or production
MPESA_CALLBACK_URL=https://api.adequatesafaris.com/api/payments/mpesa/callback
MPESA_TIMEOUT_URL=https://api.adequatesafaris.com/api/payments/mpesa/timeout

# ──────────────────────────────────────────────
# EMAIL (Transactional)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME="Adequate Safaris"

# ──────────────────────────────────────────────
# STORAGE / CDN
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-west-1
AWS_S3_BUCKET=adq-assets
AWS_CLOUDFRONT_DOMAIN=cdn.adequatesafaris.com
# Used by the Prisma seed to build absolute image URLs.
CDN_URL=https://www.adequatesafaris.com

# ──────────────────────────────────────────────
# FRONTEND URLS (public — inlined by Next.js at build time)
# ──────────────────────────────────────────────
NEXT_PUBLIC_JOOMLA_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BOOKING_URL=http://localhost:3001
NEXT_PUBLIC_ITINERARY_URL=http://localhost:3002
NEXT_PUBLIC_AGENT_URL=http://localhost:3003

# Production values (Vercel + API host):
#   NEXT_PUBLIC_JOOMLA_URL=https://www.adequatesafaris.com
#   NEXT_PUBLIC_API_URL=https://api.adequatesafaris.com
#   NEXT_PUBLIC_BOOKING_URL=https://book.adequatesafaris.com
#   NEXT_PUBLIC_ITINERARY_URL=https://plan.adequatesafaris.com
#   NEXT_PUBLIC_AGENT_URL=https://agents.adequatesafaris.com

# ──────────────────────────────────────────────
# SEEDING (optional — `npm run db:seed` in api/)
# ──────────────────────────────────────────────
SEED_PASSWORD=CHANGE_ME

# ──────────────────────────────────────────────
# ANALYTICS / TRACKING
# ──────────────────────────────────────────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GTM_CONTAINER_ID=GTM-XXXXXXX
FACEBOOK_PIXEL_ID=...
